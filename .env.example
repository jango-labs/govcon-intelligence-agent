# Copy to .env (`npm run setup` does this for you). Never commit .env.
# Every value below is a PLACEHOLDER.

# ── Data sources ────────────────────────────────────────────────────────────
# SAM.gov API key (free): https://sam.gov -> sign in -> Account Details -> Public API Key.
# Leave empty to run without SAM.gov (the other public sources still work).
SAM_API_KEY=

# ── Storage / paths (relative paths are relative to the project folder) ─────
GOVCON_DATA_DIR=./data
GOVCON_PROFILE=./config/profile.json

# ── Secret storage: "env" (this file / real environment variables) or "keyring" (macOS Keychain / Linux libsecret) ──
GOVCON_SECRET_STORE=env

# ── Web UI (binds to this computer only by default) ──────────────────────────
GOVCON_HOST=127.0.0.1
GOVCON_PORT=8787
# Required if GOVCON_HOST is not a loopback address. Use a long random string.
GOVCON_UI_TOKEN=

# ── Optional AI layer for natural-language questions (default: none; everything works without it) ──
# GOVCON_LLM_PROVIDER: none | ollama | anthropic | openai
GOVCON_LLM_PROVIDER=none
GOVCON_LLM_MODEL=
# Only for the provider you choose:
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
# OpenAI-compatible servers (LM Studio, vLLM, ...) can set a base URL:
OPENAI_BASE_URL=
OLLAMA_URL=http://127.0.0.1:11434
# Hard monthly spending cap in USD for paid providers (0 = paid calls are blocked)
GOVCON_LLM_MONTHLY_CAP_USD=0


# ── Logging ──────────────────────────────────────────────────────────────────
GOVCON_LOG_LEVEL=info
