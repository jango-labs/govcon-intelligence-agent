{
  "compilerOptions": {
    "target": "ES2023", "module": "NodeNext", "moduleResolution": "NodeNext", "strict": true, "noEmit": true,
    "allowImportingTsExtensions": true, "skipLibCheck": true, "esModuleInterop": true, "types": ["node"],
    "rewriteRelativeImportExtensions": false, "erasableSyntaxOnly": true, "verbatimModuleSyntax": true
  },
  "include": ["src", "bin", "tests", "scripts"]
}
